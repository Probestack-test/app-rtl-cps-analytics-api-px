<?xml version="1.0" encoding="UTF-8"?>
<!--
  ProxyEndpoint – default
  Defines how Apigee handles inbound HTTP requests:
    1. PreFlow: security, rate limiting, transformation (all requests)
    2. Conditional Flows: one per operation from the OpenAPI spec
    3. PostFlow: logging, response transform (all requests)
    4. FaultRules: error handling (all fault scenarios)
-->
<ProxyEndpoint name="default">
  <Description>Default proxy endpoint generated from OpenAPI spec</Description>

  <!-- ═══ FAULT RULES ═══════════════════════════════════════════════ -->
  <FaultRules>
    <FaultRule name="QuotaExceeded">
      <Condition>(fault.name == "QuotaViolation")</Condition>
      <Step><Name>AM-SetErrorHeaders</Name></Step>
      <Step><Name>RF-QuotaExceeded</Name></Step>
    </FaultRule>
    <FaultRule name="SpikeArrestViolation">
      <Condition>(fault.name == "SpikeArrestViolation")</Condition>
      <Step><Name>AM-SetErrorHeaders</Name></Step>
      <Step><Name>RF-SpikeArrestViolation</Name></Step>
    </FaultRule>
    <FaultRule name="ThreatProtection">
      <Condition>(fault.name Matches "Exceeded*")</Condition>
      <Step><Name>AM-SetErrorHeaders</Name></Step>
      <Step><Name>RF-ThreatViolation</Name></Step>
    </FaultRule>
    <FaultRule name="BackendClientError">
      <Condition>(target.received.status.code &gt;= 400) and (target.received.status.code &lt;= 499)</Condition>
      <Step><Name>AM-SetErrorHeaders</Name></Step>
      <Step><Name>RF-Handle4xxError</Name></Step>
    </FaultRule>
    <FaultRule name="BackendServerError">
      <Condition>(target.received.status.code &gt;= 500)</Condition>
      <Step><Name>AM-SetErrorHeaders</Name></Step>
      <Step><Name>RF-Handle5xxError</Name></Step>
    </FaultRule>

  </FaultRules>

<!-- Default: catch all remaining faults -->
  <DefaultFaultRule name="DefaultFaultRule">
    <AlwaysEnforce>true</AlwaysEnforce>
    <Step>
      <Name>AM-SetErrorHeaders</Name>
    </Step>
    <Step>
      <Name>RF-UnexpectedError</Name>
      <Condition>(fault.name != "QuotaViolation") and (fault.name != "SpikeArrestViolation")</Condition>
    </Step>
    <Step>
      <Name>ML-RequestLog</Name>
    </Step>
  </DefaultFaultRule>

  <!-- ═══ PRE-FLOW (every request) ═════════════════════════════════ -->
  <PreFlow name="PreFlow">
    <Request>
      <!-- Auth → Threat Protection → Rate Limit → Transform → Cache Lookup -->
      <Step>
        <Name>TP-JsonThreatProtection</Name>
        <Condition>request.content != null</Condition>
      </Step>
      <Step>
        <Name>KV-GetJwtPublicKey</Name>
      </Step>
      <Step>
        <Name>JWT-VerifyJWT</Name>
      </Step>
      <Step>
        <Name>AM-SetJwtContext</Name>
      </Step>
      <Step>
        <Name>SA-SpikeArrest</Name>
      </Step>
      <Step>
        <Name>Q-ApiQuota</Name>
      </Step>
      <Step>
        <Name>AM-AddCorrelationId</Name>
      </Step>
      <Step>
        <Name>EV-ExtractPathParams</Name>
      </Step>
      <Step>
        <Name>AM-RequestTransform</Name>
      </Step>
      <Step>
        <Name>ML-RequestLog</Name>
      </Step>

    </Request>
    <Response>
      <!-- Transform → Echo Headers → Cache Populate → Log -->
      <Step>
        <Name>AM-EchoCorrelationId</Name>
      </Step>
      <Step>
        <Name>AM-ResponseTransform</Name>
      </Step>
      <Step>
        <Name>ML-ResponseLog</Name>
      </Step>

    </Response>
  </PreFlow>

  <!-- ═══ OPERATION FLOWS (per OpenAPI path+method) ════════════════ -->
  <Flows>
    <Flow name="getGlobalOverview">
      <Description>Get system-wide summary for the home dashboard [GET /dashboard/overview]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "GET") and (proxy.pathsuffix MatchesPath "/dashboard/overview")</Condition>
    </Flow>
    <Flow name="getEnhancementMetrics">
      <Description>Get detailed metrics for enhancement runs [GET /metrics/enhancements]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "GET") and (proxy.pathsuffix MatchesPath "/metrics/enhancements")</Condition>
    </Flow>
    <Flow name="getFixPopularity">
      <Description>Get popularity/effectiveness of fix generators [GET /metrics/enhancements/fixes]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "GET") and (proxy.pathsuffix MatchesPath "/metrics/enhancements/fixes")</Condition>
    </Flow>
    <Flow name="getAssessmentMetrics">
      <Description>Get metrics for assessment scans [GET /metrics/assessments]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "GET") and (proxy.pathsuffix MatchesPath "/metrics/assessments")</Condition>
    </Flow>
    <Flow name="getTopViolations">
      <Description>Get top recurring rule violations [GET /metrics/assessments/violations/top]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "GET") and (proxy.pathsuffix MatchesPath "/metrics/assessments/violations/top")</Condition>
    </Flow>
    <Flow name="getTrends">
      <Description>Get time-series data for charts [GET /trends]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "GET") and (proxy.pathsuffix MatchesPath "/trends")</Condition>
    </Flow>
    <Flow name="generateReport">
      <Description>Generate a comprehensive offline report [POST /reports/generate]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "POST") and (proxy.pathsuffix MatchesPath "/reports/generate")</Condition>
    </Flow>
    <Flow name="getReportStatus">
      <Description>Check report generation status and download [GET /reports/{reportId}]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "GET") and (proxy.pathsuffix MatchesPath "/reports/*")</Condition>
    </Flow>
    <Flow name="cancelReport">
      <Description>Cancel report generation [DELETE /reports/{reportId}/cancel]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "DELETE") and (proxy.pathsuffix MatchesPath "/reports/*/cancel")</Condition>
    </Flow>

    <!-- Catch-all: 404 for any unmatched path -->
    <Flow name="UnmatchedPath">
      <Description>Returns 404 for requests that do not match any defined path</Description>
      <Request>
        <Step>
          <Name>RF-PathNotFound</Name>
        </Step>
      </Request>
      <Response/>
    </Flow>
  </Flows>

  <!-- ═══ POST-FLOW (only if no fault) ═════════════════════════════ -->
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>

  <!-- ═══ HTTP Proxy Connection ═════════════════════════════════════ -->
  <HTTPProxyConnection>
    <BasePath>/v1</BasePath>
    <Properties/>
  </HTTPProxyConnection>


  <RouteRule name="DefaultRoute">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
